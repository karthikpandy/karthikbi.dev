{
  "routes": [
    { "route": "/testing-the-avoid-sumx-rule", "statusCode": 404 },
    { "route": "/testing-the-avoid-sumx-rule/", "statusCode": 404 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/images/*", "*.{css,scss,js,png,gif,ico,jpg,svg,json,xml,woff,woff2,ttf,eot}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
